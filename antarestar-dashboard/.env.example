# ─────────────────────────────────────────────────────────────
# ANTARESTAR Social Media Command Center — environment
# Copy to .env.local. The app runs FULLY on bundled seed data with
# NONE of these set. Add keys to activate live integrations.
# ─────────────────────────────────────────────────────────────

# --- Google AI Studio / Gemini (AI features) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Apify (data source) ---
# Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=
# Actor IDs (defaults are the public actors named in the brief)
APIFY_ACTOR_TIKTOK_PROFILE=clockworks~tiktok-profile-scraper
APIFY_ACTOR_TIKTOK_SCRAPER=clockworks~tiktok-scraper
APIFY_ACTOR_TIKTOK_VIDEO=clockworks~tiktok-scraper
APIFY_ACTOR_INSTAGRAM_SCRAPER=apify~instagram-scraper
APIFY_ACTOR_INSTAGRAM_PROFILE=apify~instagram-profile-scraper

# --- Supabase (persistence + auth) ---
# Project settings → API. Optional; falls back to in-memory + seed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron secret to protect the scheduled sync endpoint ---
SYNC_CRON_SECRET=
